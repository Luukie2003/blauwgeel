<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/kaart_achtergrond"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/inhoud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/datumTijd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tekst_donker"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/namen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tekst_zacht"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/verwijderKnop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="✕"
        android:textColor="@color/fout"
        android:textSize="20sp" />

</LinearLayout>
