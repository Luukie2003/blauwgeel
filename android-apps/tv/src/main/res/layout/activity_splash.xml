<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_achtergrond">

    <ImageView
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="80dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/logo_transparant" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="96dp"
        android:layout_marginBottom="96dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_naam_volledig"
            android:textColor="@color/wit"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_tekst"
            android:textColor="@color/geel"
            android:textSize="18sp" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/geel" />

    </LinearLayout>

</FrameLayout>
