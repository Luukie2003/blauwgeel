<?xml version="1.0" encoding="utf-8"?>
<!-- Instellingen van de tv-app (SettingsActivity, de OK-knop): de zoom van de prijzenlijst en van de dia's. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zoom_titel"
            android:textColor="@color/wit"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:alpha="0.8"
            android:text="@string/zoom_uitleg"
            android:textColor="@color/wit" />

        <!-- Prijzenlijst -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prijzenlijst"
                android:textColor="@color/wit"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prijzenWaarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wit"
                android:textSize="20sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/prijzenSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nextFocusDown="@id/prijzenSiteKnop" />

        <Button
            android:id="@+id/prijzenSiteKnop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_card_background"
            android:paddingHorizontal="24dp"
            android:text="@string/zoals_op_de_site"
            android:textColor="@color/wit"
            android:nextFocusUp="@id/prijzenSeekbar"
            android:nextFocusDown="@id/diasSeekbar"
            app:backgroundTint="@null" />

        <!-- Dia's -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dias"
                android:textColor="@color/wit"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diasWaarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wit"
                android:textSize="20sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/diasSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/prijzenSiteKnop"
            android:nextFocusDown="@id/diasSiteKnop" />

        <Button
            android:id="@+id/diasSiteKnop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_card_background"
            android:paddingHorizontal="24dp"
            android:text="@string/zoals_op_de_site"
            android:textColor="@color/wit"
            android:nextFocusUp="@id/diasSeekbar"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:alpha="0.8"
            android:text="@string/knoppen_uitleg"
            android:textColor="@color/wit" />

        <TextView
            android:id="@+id/versie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:textColor="@color/wit" />
    </LinearLayout>
</ScrollView>
