<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zoom_titel"
            android:textColor="@color/wit"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/zoom_uitleg"
            android:textColor="@color/wit"
            android:alpha="0.8" />

        <!-- Prijzenscherm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prijzenTitel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wit"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prijzenZoomWaarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/geel"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/prijzenZoomSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/prijzenZoomResetKnop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tv_card_background"
            android:paddingHorizontal="24dp"
            android:text="@string/zoom_reset"
            android:textColor="@color/wit"
            app:backgroundTint="@null" />

        <!-- Dia's & sponsoren -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/diasTitel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wit"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diasZoomWaarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/geel"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/diasZoomSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/diasZoomResetKnop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tv_card_background"
            android:paddingHorizontal="24dp"
            android:text="@string/zoom_reset"
            android:textColor="@color/wit"
            app:backgroundTint="@null" />

        <!-- Kantine-TV (gedeeld) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gedeeldTitel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wit"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gedeeldZoomWaarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/geel"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/gedeeldZoomSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/gedeeldZoomResetKnop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_card_background"
            android:paddingHorizontal="24dp"
            android:text="@string/zoom_reset"
            android:textColor="@color/wit"
            app:backgroundTint="@null" />

        <CheckBox
            android:id="@+id/autoStartCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/auto_start_label"
            android:textColor="@color/wit" />

    </LinearLayout>
</ScrollView>
