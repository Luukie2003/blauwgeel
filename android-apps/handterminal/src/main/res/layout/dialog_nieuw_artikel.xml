<?xml version="1.0" encoding="utf-8"?>
<!-- Een nieuw artikel bij een product (ProductActivity), zoals Producten > Barcodes op de site. Een barcode vul je in
     door hem te scannen (of te typen). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/VeldLabel"
            android:text="@string/artikel_naam" />

        <EditText
            android:id="@+id/naam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/artikel_naam_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            style="@style/VeldLabel"
            android:text="@string/artikel_merk" />

        <EditText
            android:id="@+id/merk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mag_leeg"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <TextView
            style="@style/VeldLabel"
            android:text="@string/artikel_barcode" />

        <EditText
            android:id="@+id/ean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/scan_of_typ"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aantalLabel"
                    style="@style/VeldLabel" />

                <EditText
                    android:id="@+id/aantal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true"
                    android:text="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/VeldLabel"
                    android:text="@string/artikel_inkoopprijs" />

                <EditText
                    android:id="@+id/inkoopprijs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/mag_leeg"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/VeldLabel"
            android:text="@string/artikel_doos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/doosEan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/doos_barcode_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/perDoos"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:hint="@string/aantal_erin"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            style="@style/VeldLabel"
            android:text="@string/leverancier_label" />

        <Spinner
            android:id="@+id/leverancier"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/artikel_uitleg"
            android:textColor="@color/tekst_zacht"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
