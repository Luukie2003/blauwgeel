<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/leverancier"
        android:textColor="@color/tekst_zacht"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/leverancier"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/bestelling"
        android:textColor="@color/tekst_zacht"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/bestelling"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/factuurnummer"
        android:textColor="@color/tekst_zacht"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/factuurnummer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mag_leeg"
        android:importantForAutofill="no"
        android:inputType="text"
        android:singleLine="true" />
</LinearLayout>
