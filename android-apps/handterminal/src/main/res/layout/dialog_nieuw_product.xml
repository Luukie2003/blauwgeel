<?xml version="1.0" encoding="utf-8"?>
<!-- Een nieuw product vanaf de handterminal (KoppelenActivity), zoals Snel toevoegen op de site. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/VeldLabel"
            android:text="@string/nieuw_naam" />

        <EditText
            android:id="@+id/naam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nieuw_naam_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            style="@style/VeldLabel"
            android:text="@string/categorie" />

        <Spinner
            android:id="@+id/categorie"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            style="@style/VeldLabel"
            android:text="@string/nieuw_eenheid" />

        <Spinner
            android:id="@+id/eenheid"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            style="@style/VeldLabel"
            android:text="@string/nieuw_besteleenheid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/besteleenheid"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />

            <EditText
                android:id="@+id/perBesteleenheid"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:hint="@string/aantal_erin"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            style="@style/VeldLabel"
            android:text="@string/nieuw_verkoopprijs" />

        <EditText
            android:id="@+id/verkoopprijs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mag_leeg"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nieuw_product_uitleg"
            android:textColor="@color/tekst_zacht"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
