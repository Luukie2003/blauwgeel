<?xml version="1.0" encoding="utf-8"?>
<!-- Een onbekende barcode koppelen: welk product is het? Daarna nog één vraag (één losse, of een doos/krat). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/codeTekst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_geel"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/bij_welk_product"
            android:textColor="@color/tekst"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/zoekVeld"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/zoekveld"
            app:drawableStartCompat="@drawable/ic_zoeken"
            android:drawablePadding="8dp"
            app:drawableTint="@color/tekst_zacht"
            android:hint="@string/zoek_product"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/tekst"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lijst"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/kaart" />
</LinearLayout>
