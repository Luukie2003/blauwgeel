<?xml version="1.0" encoding="utf-8"?>
<!-- Factuur inboeken: een klaargezette bestelling inboeken, verder met een die nog open staat, of een nieuwe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <Button
                android:id="@+id/nieuwKnop"
                style="@style/Knop.Geel"
                android:layout_width="match_parent"
                app:drawableStartCompat="@drawable/ic_plus"
                app:drawableTint="@color/navy"
                android:text="@string/nieuwe_factuur" />

            <TextView
                android:id="@+id/uitleg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/factuur_uitleg"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp" />

            <!-- Klaargezette bestellingen: het concept van de factuur (zie facturen.py op de site). -->
            <TextView
                android:id="@+id/klaarKop"
                style="@style/Kop"
                android:text="@string/klaargezet_kop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/klaarLijst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/openKop"
                style="@style/Kop"
                android:text="@string/verder_met"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/openLijst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
