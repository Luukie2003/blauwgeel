<?xml version="1.0" encoding="utf-8"?>
<!-- Een kleine tegel onder 'Meer': een pagina die (nog) als website opent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="62dp"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/kaart_klik"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/meerIcoon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            app:tint="@color/navy" />

        <TextView
            android:id="@+id/meerNaam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/tekst"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/meerTeller"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/badge_geel"
        android:gravity="center"
        android:minWidth="17dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/navy"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
