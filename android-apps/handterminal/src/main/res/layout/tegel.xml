<?xml version="1.0" encoding="utf-8"?>
<!-- Een vak op het bord van het startscherm: een lijn-icoon, de naam in de sportletter en eronder een korte regel of een
     stand (een woord met een gekleurde stip, zoals "21 onder het minimum"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/regel_klik_kaart"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="96dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/tegelIcoon"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginBottom="7dp"
        android:contentDescription="@null"
        app:tint="@color/blauw" />

    <TextView
        android:id="@+id/tegelNaam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/blauw_donker"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tegelSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/barlow_medium"
        android:singleLine="true"
        android:textColor="@color/tekst_zacht"
        android:textSize="13sp" />
</LinearLayout>
