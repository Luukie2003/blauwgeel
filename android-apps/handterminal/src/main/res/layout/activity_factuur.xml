<?xml version="1.0" encoding="utf-8"?>
<!-- Eén factuur: scannen, het totaal naast het bedrag op de factuur, per product wat erbij komt, de scans (met min en
     plus), en afronden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/scanMelding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/badge_geel"
                android:padding="10dp"
                android:text="@string/scan_dozen"
                android:textColor="@color/navy"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gescand_totaal"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/totaal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tekst"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bedragKnop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/op_de_factuur"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bedrag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/verschil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bij een klaargezette bestelling: per besteld product besteld, gescand en wat er nog mist. -->
            <TextView
                android:id="@+id/besteldKop"
                style="@style/Kop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/besteld"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Kop"
                android:text="@string/per_product" />

            <LinearLayout
                android:id="@+id/perProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp" />

            <TextView
                style="@style/Kop"
                android:text="@string/scans_kop" />

            <LinearLayout
                android:id="@+id/regels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="2dp" />

            <Button
                android:id="@+id/intikKnop"
                style="@style/Knop.Rand"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/barcode_intikken"
                android:textSize="15sp" />

            <Button
                android:id="@+id/pluKnop"
                style="@style/Knop.Rand"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/plu_knop"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/afrondenKnop"
        style="@style/Knop.Geel"
        android:layout_width="match_parent"
        android:layout_margin="8dp"
        app:drawableStartCompat="@drawable/ic_vink"
        app:drawableTint="@color/navy"
        android:text="@string/afronden_en_inboeken" />
</LinearLayout>
