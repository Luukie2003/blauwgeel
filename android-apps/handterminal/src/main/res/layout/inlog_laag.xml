<?xml version="1.0" encoding="utf-8"?>
<!-- Het inlogscherm: bovenaan de kop van de site (het wapen en KANTINE BLAUW-GEEL op donkerblauw, met de gele streep),
     daaronder zes vakjes voor de code en een groot cijferpad in de sportletter. Ontworpen voor het kleine, staande
     scherm van de TC51 (5 inch); de lege ruimtes rekken mee, zodat het ook op een groter scherm in balans blijft. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/papier"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blauw_donker"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/inlogLogo"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:adjustViewBounds="true"
                android:clickable="true"
                android:contentDescription="@string/club"
                android:focusable="true"
                android:src="@drawable/clublogo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/barlow_condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="@string/merk"
                android:textAllCaps="true"
                android:textColor="@color/wit"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/barlow_medium"
                android:text="@string/merk_sub"
                android:textColor="@color/tekst_zacht_op_blauw"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/geel" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4"
            android:minHeight="14dp" />

        <TextView
            android:id="@+id/inlogInstructie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/code_instructie"
            android:textColor="@color/tekst"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/stippen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <View style="@style/CodeVak" />
            <View style="@style/CodeVak" />
            <View style="@style/CodeVak" />
            <View style="@style/CodeVak" />
            <View style="@style/CodeVak" />
            <View style="@style/CodeVak" />
        </LinearLayout>

        <!-- Vaste hoogte, zodat het cijferpad niet verspringt als er een melding komt. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp">

            <TextView
                android:id="@+id/inlogMelding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/melding_fout"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/tekst"
                android:textSize="13sp"
                android:visibility="invisible" />

            <ProgressBar
                android:id="@+id/inlogBezig"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/blauw"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/toetsen"
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/toets1" style="@style/Cijfertoets" android:text="1" />
                <TextView android:id="@+id/toets2" style="@style/Cijfertoets" android:text="2" />
                <TextView android:id="@+id/toets3" style="@style/Cijfertoets" android:text="3" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/toets4" style="@style/Cijfertoets" android:text="4" />
                <TextView android:id="@+id/toets5" style="@style/Cijfertoets" android:text="5" />
                <TextView android:id="@+id/toets6" style="@style/Cijfertoets" android:text="6" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/toets7" style="@style/Cijfertoets" android:text="7" />
                <TextView android:id="@+id/toets8" style="@style/Cijfertoets" android:text="8" />
                <TextView android:id="@+id/toets9" style="@style/Cijfertoets" android:text="9" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/toetsWis" style="@style/Cijfertoets.Klein" android:text="@string/toets_wis" />
                <TextView android:id="@+id/toets0" style="@style/Cijfertoets" android:text="0" />
                <ImageView
                    android:id="@+id/toetsTerug"
                    style="@style/Cijfertoets.Klein"
                    android:contentDescription="@string/toets_terug"
                    android:scaleType="center"
                    android:src="@drawable/ic_terug_wissen"
                    app:tint="@color/blauw" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:minHeight="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/inlogVerbinding"
                style="@style/Stand"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/barlow_medium"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/inlogVersie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
