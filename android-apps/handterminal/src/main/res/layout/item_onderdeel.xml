<?xml version="1.0" encoding="utf-8"?>
<!-- Een onderdeel in het blad van een onderwerp, als vak op een bord: een lijn-icoon, de naam in de sportletter, een
     korte uitleg en eventueel een stand (een woord met een gekleurde stip). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/regel_klik_kaart"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="104dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/onderdeelIcoon"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginBottom="7dp"
        android:contentDescription="@null"
        app:tint="@color/blauw" />

    <TextView
        android:id="@+id/onderdeelNaam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/barlow_condensed"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/blauw_donker"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onderdeelUitleg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/tekst_zacht"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/onderdeelTeller"
        style="@style/Stand"
        android:layout_marginTop="5dp"
        android:visibility="gone" />
</LinearLayout>
