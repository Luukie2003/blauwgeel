<?xml version="1.0" encoding="utf-8"?>
<!-- Eén product: de voorraad, en meteen daaronder boeken (zonder te scrollen op een TC51). Daaronder alles van de
     productpagina van de site: kerncijfers, verkoop en verwachting, prijzen, inkoop en bestellen (infoBoven), de laatste
     boekingen, de artikelen en barcodes en de laatste tellingen (infoOnder). Die blokken bouwt ProductActivity zelf. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/scanMelding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/badge_geel"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Voorraad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/productFoto"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voorraad"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/voorraad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tekst"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/voorraadSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/kenmerken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/navy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/laagLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/badge_rood"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/laag"
                    android:textColor="@color/wit"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/productOpmerking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_geel"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Boeken -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/erinKnop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/keuze_groot"
                        android:clickable="true"
                        app:drawableStartCompat="@drawable/ic_erin"
                        android:drawablePadding="6dp"
                        app:drawableTint="@color/keuze_tekst"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/erin"
                        android:textColor="@color/keuze_tekst"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/eruitKnop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/keuze_groot"
                        android:clickable="true"
                        app:drawableStartCompat="@drawable/ic_eruit"
                        android:drawablePadding="6dp"
                        app:drawableTint="@color/keuze_tekst"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/eruit"
                        android:textColor="@color/keuze_tekst"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/minKnop"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/minder"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_min"
                        app:tint="@color/tekst" />

                    <TextView
                        android:id="@+id/aantal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:textColor="@color/tekst"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/plusKnop"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/meer_aantal"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/tekst" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/snelKnoppen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <HorizontalScrollView
                    android:id="@+id/redenenScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/redenen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/boekKnop"
                    style="@style/Knop.Geel"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/infoBoven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Kop"
                android:paddingStart="4dp"
                android:text="@string/laatste_boekingen" />

            <LinearLayout
                android:id="@+id/mutaties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp" />

            <TextView
                style="@style/Kop"
                android:paddingStart="4dp"
                android:text="@string/artikelen_en_barcodes" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kaart"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/barcodeLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/koppelKnop"
                    style="@style/Knop.Rand"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    app:drawableStartCompat="@drawable/ic_koppelen"
                    app:drawableTint="@color/navy"
                    android:text="@string/barcode_koppelen"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/infoOnder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
