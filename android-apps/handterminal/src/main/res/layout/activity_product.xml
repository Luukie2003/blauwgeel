<?xml version="1.0" encoding="utf-8"?>
<!-- Eén product: de foto en de naam met zijn stand, de voorraad naast het minimum, en meteen daaronder boeken (zonder te
     scrollen op een TC51): Erin of Eruit als twee grote vakken, het aantal en één gele knop die zegt wat er gebeurt.
     Daaronder alles van de productpagina van de site: kerncijfers, verkoop en verwachting, prijzen, inkoop en bestellen
     (infoBoven), de laatste boekingen, de artikelen en barcodes en de laatste tellingen (infoOnder). Die blokken bouwt
     ProductActivity zelf. Gescand vanuit het menu (alleen de informatie) zet ProductActivity boekBlok onderaan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/papier"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <!-- De foto, de naam en de stand ("Onder het minimum") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/productFoto"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/foto_kader"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/productNaam"
                        style="@style/Titel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="3"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/laagLabel"
                        style="@style/Stand"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/kenmerken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/blauw"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- De stand: op voorraad naast het minimum -->
            <LinearLayout
                android:id="@+id/standPaneel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/kaart"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/scheiding_staand"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/voorraad"
                            style="@style/Getal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textSize="33sp" />

                        <TextView
                            android:id="@+id/voorraadSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/barlow_medium"
                            android:singleLine="true"
                            android:text="@string/op_voorraad"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/minimum"
                            style="@style/Getal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textSize="33sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/barlow_medium"
                            android:text="@string/minimum_label"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/productOpmerking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/melding_let_op"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/tekst"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Boeken: Erin of Eruit, het aantal en de gele knop -->
            <LinearLayout
                android:id="@+id/boekBlok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/kaart"
                android:orientation="vertical">

                <LinearLayout style="@style/PaneelKop">

                    <TextView
                        style="@style/PaneelKop.Tekst"
                        android:text="@string/erin_of_eruit" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scanMelding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/tekst"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_scan"
                    app:drawableTint="@color/blauw" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/erinKnop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/keuze_groot"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_erin"
                            app:tint="@color/keuze_groot_tekst" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/barlow_condensed"
                            android:includeFontPadding="false"
                            android:text="@string/erin"
                            android:textColor="@color/keuze_groot_tekst"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eruitKnop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/keuze_groot"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_eruit"
                            app:tint="@color/keuze_groot_tekst" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/barlow_condensed"
                            android:includeFontPadding="false"
                            android:text="@string/eruit"
                            android:textColor="@color/keuze_groot_tekst"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/minKnop"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/minder"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_min"
                        app:tint="@color/blauw_donker" />

                    <TextView
                        android:id="@+id/aantal"
                        style="@style/Getal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/getal_vak"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textSize="34sp" />

                    <ImageView
                        android:id="@+id/plusKnop"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/meer_aantal"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/blauw_donker" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/snelKnoppen"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal" />

                <HorizontalScrollView
                    android:id="@+id/redenenScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/redenen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/boekKnop"
                    style="@style/Knop.Geel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="12dp" />
            </LinearLayout>

            <!-- Op de tv: uitverkocht zetten op het prijzenscherm (alleen als het product daarop staat). -->
            <LinearLayout
                android:id="@+id/tvBlok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/infoBoven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/mutatiesPaneel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/kaart"
                android:orientation="vertical">

                <LinearLayout style="@style/PaneelKop">

                    <TextView
                        style="@style/PaneelKop.Tekst"
                        android:text="@string/laatste_boekingen" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mutaties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/scheiding"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/kaart"
                android:orientation="vertical">

                <LinearLayout style="@style/PaneelKop">

                    <TextView
                        style="@style/PaneelKop.Tekst"
                        android:text="@string/artikelen_en_barcodes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/barcodeLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp" />

                <Button
                    android:id="@+id/koppelKnop"
                    style="@style/Knop.Rand"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/barcode_koppelen"
                    app:drawableStartCompat="@drawable/ic_koppelen"
                    app:drawableTint="@color/blauw" />

                <Button
                    android:id="@+id/artikelKnop"
                    style="@style/Knop.Rand"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_margin="12dp"
                    android:text="@string/artikel_toevoegen"
                    app:drawableStartCompat="@drawable/ic_plus"
                    app:drawableTint="@color/blauw" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/infoOnder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
