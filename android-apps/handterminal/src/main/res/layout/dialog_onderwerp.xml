<?xml version="1.0" encoding="utf-8"?>
<!-- Een onderwerp van het startscherm (Voorraad en bestellen, Kantine en keuken, ...): een blad dat van onderen omhoog
     schuift, met bovenin de donkerblauwe kop met de gele streep en daaronder de onderdelen op een bord. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blad"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bladKop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/blad_kop"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/blad_greep" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bladIcoon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                app:tint="@color/geel" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bladTitel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed"
                    android:includeFontPadding="false"
                    android:textColor="@color/wit"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bladSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/barlow_medium"
                    android:textColor="@color/tekst_zacht_op_blauw"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/geel" />

    <LinearLayout
        android:id="@+id/bladLijst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />
</LinearLayout>
