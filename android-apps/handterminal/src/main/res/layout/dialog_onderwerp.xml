<?xml version="1.0" encoding="utf-8"?>
<!-- Een onderwerp van het startscherm (Voorraad en bestellen, Kantine en keuken, ...): een blad dat van onderen omhoog
     schuift, met bovenin een navy kop en daaronder de onderdelen als kaarten, twee naast elkaar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blad"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bladKop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/blad_kop"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/blad_greep" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bladIcoon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/icoon_cirkel_geel"
                android:contentDescription="@null"
                android:padding="11dp"
                app:tint="@color/navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bladTitel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wit"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bladSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tekst_zacht_op_navy"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bladLijst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp" />
</LinearLayout>
