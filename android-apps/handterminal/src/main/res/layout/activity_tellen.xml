<?xml version="1.0" encoding="utf-8"?>
<!-- Tellen met de looplijst: product voor product (eerst de bar, dan het voorraadhok), met een vast cijferpad onderin.
     Daarna het controlescherm en de bevestiging. Drie lagen in één scherm; TellenActivity toont er steeds één. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ProgressBar
        android:id="@+id/voortgang"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="1000"
        android:progressDrawable="@drawable/voortgang" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Laden: wat hij aan het doen is -->
        <LinearLayout
            android:id="@+id/laden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/ladenTekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tekst_zacht"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Tellen: zoals de looplijst op de site ===== -->
        <LinearLayout
            android:id="@+id/telLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/faseLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/telBarGeteld"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/telFoto"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/foto_kader"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/telCategorie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAllCaps="true"
                                android:textColor="@color/tekst_zacht"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/telNaam"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:textColor="@color/tekst"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/telVoorraad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tekst_zacht"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/telVerwacht"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/kaart"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/telWaarde"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tekst"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/telEenheid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/rekenKnop"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/rekenmachine"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_rekenmachine"
                        app:tint="@color/navy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/snelKnoppen"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/snelNul" style="@style/Toets" android:text="0" android:textSize="17sp" />
                    <TextView android:id="@+id/snelMin1" style="@style/Toets" android:text="−1" android:textSize="17sp" />
                    <TextView android:id="@+id/snelPlus1" style="@style/Toets" android:text="+1" android:textSize="17sp" />
                    <TextView android:id="@+id/snelPlus2" style="@style/Toets" android:text="+2" android:textSize="17sp" />
                    <TextView
                        android:id="@+id/snelKrat"
                        style="@style/Toets"
                        android:layout_weight="2"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

                <include
                    android:id="@+id/pad"
                    layout="@layout/cijferpad"
                    android:layout_width="match_parent"
                    android:layout_height="184dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vorigeKnop"
                        style="@style/Toets"
                        android:layout_weight="1"
                        android:text="@string/vorige_pijl"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/volgendeKnop"
                        style="@style/Toets.Navy"
                        android:layout_weight="1.8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pauzeerKnop"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/pauzeren_later_verder"
                        android:textColor="@color/navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/stopKnop"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/stoppen_zonder_opslaan"
                        android:textColor="@color/rood_balk"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Controleren ===== -->
        <LinearLayout
            android:id="@+id/controleLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/controle_uitleg"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/kaart">

                <LinearLayout
                    android:id="@+id/controleLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/terugNaarTellenKnop"
                    style="@style/Knop.Rand"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/terug_naar_tellen" />

                <Button
                    android:id="@+id/opslaanKnop"
                    style="@style/Knop.Geel"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:text="@string/telling_opslaan" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Klaar ===== -->
        <LinearLayout
            android:id="@+id/klaarLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/icoon_cirkel"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_vink"
                app:tint="@color/geel" />

            <TextView
                android:id="@+id/klaarTitel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/tekst"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/klaarTekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/tekst_zacht"
                android:textSize="15sp" />

            <Button
                android:id="@+id/bekijkKnop"
                style="@style/Knop.Rand"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:text="@string/bekijk_telling" />

            <Button
                android:id="@+id/klaarKnop"
                style="@style/Knop.Geel"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/naar_start" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
