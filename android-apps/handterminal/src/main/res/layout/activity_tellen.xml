<?xml version="1.0" encoding="utf-8"?>
<!-- Tellen met de looplijst: product voor product (eerst de bar, dan het voorraadhok), met een vast cijferpad onderin.
     Onder de kop is de gele streep de voortgang: hij loopt vol terwijl je telt. Daarna het controlescherm en de
     bevestiging. Drie lagen in één scherm; TellenActivity (en KeukenTellenActivity) toont er steeds één. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/papier"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <ProgressBar
        android:id="@+id/voortgang"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="1000"
        android:progressDrawable="@drawable/voortgang" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Laden: wat hij aan het doen is -->
        <LinearLayout
            android:id="@+id/laden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/blauw" />

            <TextView
                android:id="@+id/ladenTekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tekst_zacht"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Tellen: zoals de looplijst op de site ===== -->
        <LinearLayout
            android:id="@+id/telLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp">

                    <!-- Bar of voorraadhok (een stand met een stip), rechts de categorie -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/faseLabel"
                            style="@style/Stand"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/telCategorie"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/telFoto"
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/foto_kader"
                            android:contentDescription="@null"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/telNaam"
                                style="@style/Titel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="2" />

                            <TextView
                                android:id="@+id/telVoorraad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:textColor="@color/tekst_zacht"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/telVerwacht"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tekst_zacht"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/telBarGeteld"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tekst"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingEnd="11dp">

                <!-- Het getal (met de eenheid) en de rekenmachine -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/getal_vak"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/telWaarde"
                            style="@style/Getal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/telEenheid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/rekenKnop"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/toets_licht"
                        android:clickable="true"
                        android:contentDescription="@string/rekenmachine"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_rekenmachine"
                        app:tint="@color/blauw_donker" />
                </LinearLayout>

                <!-- De snelknoppen van de looplijst op de site -->
                <LinearLayout
                    android:id="@+id/snelKnoppen"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/snelNul" style="@style/Toets.Snel" android:text="0" />
                    <TextView android:id="@+id/snelMin1" style="@style/Toets.Snel" android:text="−1" />
                    <TextView android:id="@+id/snelPlus1" style="@style/Toets.Snel" android:text="+1" />
                    <TextView android:id="@+id/snelPlus2" style="@style/Toets.Snel" android:text="+2" />
                    <TextView
                        android:id="@+id/snelKrat"
                        style="@style/Toets.Snel"
                        android:layout_weight="2.6"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <include
                    android:id="@+id/pad"
                    layout="@layout/cijferpad"
                    android:layout_width="match_parent"
                    android:layout_height="186dp"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vorigeKnop"
                        style="@style/Toets.Rand"
                        android:layout_weight="1"
                        android:text="@string/vorige_pijl" />

                    <TextView
                        android:id="@+id/volgendeKnop"
                        style="@style/Toets.Geel"
                        android:layout_weight="1.8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pauzeerKnop"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/toets_rustig"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/pauzeren_later_verder"
                        android:textColor="@color/blauw"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stopKnop"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/toets_rustig"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/stoppen_zonder_opslaan"
                        android:textColor="@color/rood"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Controleren ===== -->
        <LinearLayout
            android:id="@+id/controleLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/controleUitleg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/controle_uitleg"
                android:textColor="@color/tekst_zacht"
                android:textSize="13sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/kaart">

                <LinearLayout
                    android:id="@+id/controleLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rand" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <Button
                    android:id="@+id/terugNaarTellenKnop"
                    style="@style/Knop.Rand"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/terug_naar_tellen" />

                <Button
                    android:id="@+id/opslaanKnop"
                    style="@style/Knop.Geel"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:text="@string/telling_opslaan" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Klaar ===== -->
        <LinearLayout
            android:id="@+id/klaarLaag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_vink"
                app:tint="@color/groen" />

            <TextView
                android:id="@+id/klaarTitel"
                style="@style/Titel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/klaarTekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/tekst_zacht"
                android:textSize="15sp" />

            <Button
                android:id="@+id/bekijkKnop"
                style="@style/Knop.Rand"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:text="@string/bekijk_telling" />

            <Button
                android:id="@+id/klaarKnop"
                style="@style/Knop.Geel"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/naar_start" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
