<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/verversen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/updateMelding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/badge_geel"
                    android:padding="10dp"
                    android:textColor="@color/navy"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/zoekKnop"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/zoekveld"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_zoeken"
                        app:tint="@color/tekst_zacht" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/zoek_of_scan"
                        android:textColor="@color/tekst_zacht"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tegels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include android:id="@+id/tegelFactuur" layout="@layout/tegel" />
                        <include android:id="@+id/tegelTellen" layout="@layout/tegel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include android:id="@+id/tegelBoeken" layout="@layout/tegel" />
                        <include android:id="@+id/tegelVoorraad" layout="@layout/tegel" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/letOpKop"
                    style="@style/Kop"
                    android:layout_marginStart="4dp"
                    android:text="@string/let_op"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/letOpLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/meerKop"
                    style="@style/Kop"
                    android:layout_marginStart="4dp"
                    android:text="@string/meer"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/meerLijst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/standTekst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/tekst_zacht"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
