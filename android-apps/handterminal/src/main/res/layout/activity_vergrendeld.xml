<?xml version="1.0" encoding="utf-8"?>
<!-- Het vergrendel-scherm tijdens een noodstop (VergrendeldActivity): dezelfde boodschap als op de tv. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/achtergrond_inlog"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kantinesysteem"
                android:textAllCaps="true"
                android:textColor="@color/tekst_zacht_op_navy"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/stip_vol" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vergrendeld"
                android:textAllCaps="true"
                android:textColor="@color/geel"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/slot_kring">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/vergrendeld"
                android:src="@drawable/ic_slot"
                app:tint="@color/navy" />
        </FrameLayout>

        <TextView
            android:id="@+id/titel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/wit"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/vergrendeld_uitleg"
            android:textColor="@color/tekst_op_navy"
            android:textSize="15sp" />

        <TextView
            style="@style/KenmerkOpNavy"
            android:layout_marginTop="18dp"
            android:text="@string/vergrendeld_veilig" />

        <TextView
            style="@style/KenmerkOpNavy"
            android:text="@string/vergrendeld_bar_open" />

        <TextView
            style="@style/KenmerkOpNavy"
            android:text="@string/vergrendeld_toestel" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/wit"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sinds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/tekst_zacht_op_navy"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
