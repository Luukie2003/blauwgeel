<?xml version="1.0" encoding="utf-8"?>
<!-- Een eenvoudig lijstscherm (prikbord, bestellijst, tellingen, geschiedenis): de kopbalk, de inhoud in kaarten
     (opgebouwd door het scherm zelf, zie Lijst.kt) en eventueel een knop onderaan. Omlaag vegen ververst. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/achtergrond"
    android:orientation="vertical">

    <include
        android:id="@+id/balk"
        layout="@layout/balk" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/verversen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/inhoud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="14dp" />
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <Button
        android:id="@+id/onderKnop"
        style="@style/Knop.Geel"
        android:layout_width="match_parent"
        android:layout_margin="8dp"
        android:visibility="gone" />
</LinearLayout>
