<?xml version="1.0" encoding="utf-8"?>
<!-- Een pagina die (nog) geen eigen scherm in de app heeft, als website: de kopbalk van de app, de WebView en een
     foutscherm voor als de verbinding wegvalt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <LinearLayout
        android:id="@+id/siteLaag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/balk"
            layout="@layout/balk" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/achtergrond">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/verversen"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <ProgressBar
                android:id="@+id/voortgang"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progressDrawable="@drawable/voortgang"
                android:visibility="gone" />

            <!-- Foutscherm: geen netwerk, website onbereikbaar, of versturen niet bevestigd. -->
            <ScrollView
                android:id="@+id/foutLaag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/achtergrond"
                android:clickable="true"
                android:fillViewport="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kaart"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="26dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp">

                        <ImageView
                            android:id="@+id/foutIcoon"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/fout_icoon_achtergrond"
                            android:contentDescription="@null"
                            android:padding="18dp"
                            android:src="@drawable/ic_wifi_uit"
                            app:tint="@color/geel" />

                        <TextView
                            android:id="@+id/foutTitel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="@color/tekst"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/foutTekst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/foutKnop"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/knop_geel"
                            android:stateListAnimator="@null"
                            android:text="@string/fout_opnieuw"
                            android:textAllCaps="false"
                            android:textColor="@color/navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/foutTestKnop"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/knop_rand"
                            android:stateListAnimator="@null"
                            android:text="@string/fout_test"
                            android:textAllCaps="false"
                            android:textColor="@color/tekst"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/foutAftellen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/tekst_zacht"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
