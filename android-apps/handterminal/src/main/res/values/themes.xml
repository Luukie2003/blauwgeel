<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bewust een vaste lichte stijl, niet DayNight: de app volgt de huisstijl van de site. Het inlogscherm is navy,
         de werkschermen lichtgrijs met witte kaarten, net als de handterminal-weergave van de site. -->
    <style name="Thema.Handterminal" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/geel_donker</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
    </style>

    <style name="Thema.Handterminal.Licht">
        <item name="android:windowBackground">@color/achtergrond</item>
        <item name="android:textColorPrimary">@color/tekst</item>
    </style>

    <style name="Thema.Handterminal.Instellingen" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/geel_donker</item>
        <item name="android:windowBackground">@color/achtergrond</item>
    </style>

    <!-- ===== Inlogscherm ===== -->

    <style name="Cijfertoets">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/toets</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/toets_tekst</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:soundEffectsEnabled">true</item>
    </style>

    <style name="Cijfertoets.Klein">
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/toets_rustig</item>
    </style>

    <style name="CodeStip">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/stip_leeg</item>
    </style>

    <!-- Het label boven een veld in een dialoog (dialog_nieuw_product.xml). -->
    <style name="VeldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/tekst_zacht</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Een kenmerk op het vergrendel-scherm (activity_vergrendeld.xml). -->
    <style name="KenmerkOpNavy">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/kenmerk_op_navy</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/tekst_op_navy</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ===== Werkschermen ===== -->

    <style name="Knop">
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Knop.Geel">
        <item name="android:background">@drawable/knop_geel</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Knop.Rand">
        <item name="android:background">@drawable/knop_rand</item>
        <item name="android:textColor">@color/tekst</item>
    </style>

    <style name="Kop">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/tekst_zacht</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Toets">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/toets_licht</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tekst</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Toets.Navy">
        <item name="android:background">@drawable/toets_navy</item>
        <item name="android:textColor">@color/toets_navy_tekst</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Keuze">
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/keuze</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/keuze_tekst</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="InstellingKop">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/tekst_zacht</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
