<?xml version="1.0" encoding="utf-8"?>
<!-- Erin of Eruit: twee grote vakken, het gekozen vak donkerblauw (met gele letters, zie color/keuze_groot_tekst). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><corners android:radius="6dp" /><solid android:color="@color/blauw_donker" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="6dp" /><solid android:color="@color/ingedrukt" /><stroke android:width="1dp" android:color="@color/knoprand" /></shape>
    </item>
    <item>
        <shape><corners android:radius="6dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="@color/knoprand" /></shape>
    </item>
</selector>
