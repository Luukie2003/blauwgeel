<?xml version="1.0" encoding="utf-8"?>
<!-- Een witte kaart die je kunt aantikken (tegels, regels in een lijst). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="10dp" /><solid android:color="#FFF6D6" /><stroke android:width="1dp" android:color="@color/geel_donker" /></shape>
    </item>
    <item>
        <shape><corners android:radius="10dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="@color/rand_licht" /></shape>
    </item>
</selector>
