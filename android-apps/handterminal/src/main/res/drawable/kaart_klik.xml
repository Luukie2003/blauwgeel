<?xml version="1.0" encoding="utf-8"?>
<!-- Een paneel dat je kunt aantikken: lichtgeel onder je vinger. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="6dp" /><solid android:color="@color/ingedrukt" /><stroke android:width="1dp" android:color="@color/rand" /></shape>
    </item>
    <item>
        <shape><corners android:radius="6dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="@color/rand" /></shape>
    </item>
</selector>
