<?xml version="1.0" encoding="utf-8"?>
<!-- Een cijfertoets: rustig glas op navy, geel als je hem indrukt (zoals de knoppen op de site). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/geel" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/knop_op_navy" />
            <stroke android:width="1dp" android:color="@color/knop_op_navy_rand" />
        </shape>
    </item>
</selector>
