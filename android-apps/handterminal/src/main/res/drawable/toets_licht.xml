<?xml version="1.0" encoding="utf-8"?>
<!-- Een toets of knop met een icoon (−, +, de rekenmachine): wit met de knoprand, geel als je hem indrukt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="6dp" /><solid android:color="@color/geel" /><stroke android:width="1dp" android:color="@color/geel_donker" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape><corners android:radius="6dp" /><solid android:color="@color/papier" /><stroke android:width="1dp" android:color="@color/rand" /></shape>
    </item>
    <item>
        <shape><corners android:radius="6dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="@color/knoprand" /></shape>
    </item>
</selector>
