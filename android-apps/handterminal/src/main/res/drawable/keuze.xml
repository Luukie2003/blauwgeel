<?xml version="1.0" encoding="utf-8"?>
<!-- Een keuzeknop (chip, of Erin/Eruit): gekozen = navy, anders wit met rand. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><corners android:radius="18dp" /><solid android:color="@color/navy" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="18dp" /><solid android:color="#FFF6D6" /><stroke android:width="1dp" android:color="@color/geel_donker" /></shape>
    </item>
    <item>
        <shape><corners android:radius="18dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="#C4C8D0" /></shape>
    </item>
</selector>
