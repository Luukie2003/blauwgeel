<?xml version="1.0" encoding="utf-8"?>
<!-- Een aantikbare regel binnen een paneel: doorzichtig (het paneel met zijn hoeken en rand blijft zichtbaar),
     lichtgeel als je erop drukt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><color android:color="@color/ingedrukt" /></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
