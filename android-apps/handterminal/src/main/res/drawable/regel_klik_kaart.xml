<?xml version="1.0" encoding="utf-8"?>
<!-- Een aantikbare regel binnen een kaart: doorzichtig (de kaart met zijn ronde hoeken en rand blijft zichtbaar),
     lichtgeel als je erop drukt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><color android:color="#FFF6D6" /></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
