<?xml version="1.0" encoding="utf-8"?>
<!-- Stop (de schijnwerper op de tv's): wit met een rode rand en rode letters. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="6dp" /><solid android:color="#FBEAE6" /><stroke android:width="1dp" android:color="@color/rood_rand" /></shape>
    </item>
    <item>
        <shape><corners android:radius="6dp" /><solid android:color="@color/kaart" /><stroke android:width="1dp" android:color="@color/rood_rand" /></shape>
    </item>
</selector>
