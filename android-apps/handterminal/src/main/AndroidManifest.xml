<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Voor de wifi-lock: houdt de wifi op volle kracht zolang de app voorin staat (zie HoofdActivity). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- DataWedge is de scanner-software van Zebra (zie Scanner.kt). -->
    <queries>
        <package android:name="com.symbol.datawedge" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_naam"
        android:networkSecurityConfig="@xml/netwerkbeveiliging"
        android:supportsRtl="false"
        android:theme="@style/Thema.Handterminal">

        <activity
            android:name=".HoofdActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InstellingenActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Thema.Handterminal.Instellingen" />
    </application>
</manifest>
